{
  "description": "watch — prints a one-line setup status at session start, silent when everything is ready.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/session_start.sh\""
          }
        ]
      }
    ]
  }
}
